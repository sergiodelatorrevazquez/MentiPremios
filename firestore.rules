rules_version = '2';

// Sin servidor intermedio: el navegador lee y escribe directamente. Hay una
// colección de personas, `codes`, con un documento por invitado, y un documento
// de totales, `votes/actual`, con un contador por opción.
//
// La seguridad se apoya en una sola idea: se puede leer un documento concreto si
// ya se conoce su identificador (la palabra secreta), pero nunca se puede
// enumerar la colección. Sin `list`, nadie puede descubrir las palabras del
// resto de participantes ni quién ha respondido ya.
//
// El coste de que los votes vivan en el mismo documento es que leer a un
// amigo devuelve también sus respuestas.
service cloud.firestore {
  match /databases/{database}/documents {
    // Los campos que una escritura cambia de verdad, quitando los que vienen a
    // `null` por no estar. Se declara aquí, al nivel del servicio y no dentro de
    // un `match`, que es donde el lenguaje de reglas lo espera y donde queda
    // disponible para cualquier documento sin repetirlo.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /codes/{invitationId} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if false;

      // Al votar se escribe, en el mismo documento, `voted` a true y un campo
      // por pregunta con la opción elegida. `diff` acota el cambio a esa lista
      // exacta, así que no se pueden escribir campos inventados ni devolver
      // una invitación ya votada a sin votar. No hay ningún otro campo que
      // proteger: el documento no guarda datos sobre la persona aparte del
      // identificador.
      //
      // `admin` lo pone el organizador al crear la invitación y no lo toca
      // nadie: como no está en la lista blanca, no se puede alterar con una
      // llamada normal.
      //
      // La lista debe coincidir con `QUESTION_IDS`; el test de contrato de
      // `firestore.rules` falla si se añade una pregunta y no se añade aquí.
      allow update: if resource.data.voted == false
        && request.resource.data.voted == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'voted',
          'tonto',
          'casper',
          'comefeas',
          'soltero',
          'anecdota',
          'meme',
          'mensaje',
          'foto',
          'video',
          'correa',
        ]);
    }

    match /votes/{voteId} {
      function isCounterIncrementValid(changedKeys, optionId) {
        return !changedKeys.hasAny([optionId])
          || request.resource.data.get(optionId, 0) == resource.data.get(optionId, 0) + 1;
      }

      function isVoteUpdateValid(id) {
        let changedKeys = changed();
        return id == 'actual'
          && changedKeys.size() == 10
          && changedKeys.hasOnly([
            'tonto-1',
            'tonto-2',
            'tonto-3',
            'tonto-4',
            'casper-1',
            'casper-2',
            'casper-3',
            'casper-4',
            'casper-5',
            'casper-6',
            'comefeas-1',
            'comefeas-2',
            'comefeas-3',
            'comefeas-4',
            'soltero-1',
            'soltero-2',
            'soltero-3',
            'soltero-4',
            'anecdota-1',
            'anecdota-2',
            'anecdota-3',
            'anecdota-4',
            'anecdota-5',
            'anecdota-6',
            'meme-1',
            'meme-2',
            'meme-3',
            'meme-4',
            'meme-5',
            'meme-6',
            'meme-7',
            'meme-8',
            'mensaje-1',
            'mensaje-2',
            'mensaje-3',
            'mensaje-4',
            'foto-1',
            'foto-2',
            'foto-3',
            'foto-4',
            'video-1',
            'video-2',
            'video-3',
            'video-4',
            'correa-1',
            'correa-2',
            'correa-3',
            'correa-4',
          ])
          && changedKeys.hasAny(['tonto-1', 'tonto-2', 'tonto-3', 'tonto-4'])
          && changedKeys.hasAny(['casper-1', 'casper-2', 'casper-3', 'casper-4', 'casper-5', 'casper-6'])
          && changedKeys.hasAny(['comefeas-1', 'comefeas-2', 'comefeas-3', 'comefeas-4'])
          && changedKeys.hasAny(['soltero-1', 'soltero-2', 'soltero-3', 'soltero-4'])
          && changedKeys.hasAny(['anecdota-1', 'anecdota-2', 'anecdota-3', 'anecdota-4', 'anecdota-5', 'anecdota-6'])
          && changedKeys.hasAny(['meme-1', 'meme-2', 'meme-3', 'meme-4', 'meme-5', 'meme-6', 'meme-7', 'meme-8'])
          && changedKeys.hasAny(['mensaje-1', 'mensaje-2', 'mensaje-3', 'mensaje-4'])
          && changedKeys.hasAny(['foto-1', 'foto-2', 'foto-3', 'foto-4'])
          && changedKeys.hasAny(['video-1', 'video-2', 'video-3', 'video-4'])
          && changedKeys.hasAny(['correa-1', 'correa-2', 'correa-3', 'correa-4'])
          && isCounterIncrementValid(changedKeys, 'tonto-1')
          && isCounterIncrementValid(changedKeys, 'tonto-2')
          && isCounterIncrementValid(changedKeys, 'tonto-3')
          && isCounterIncrementValid(changedKeys, 'tonto-4')
          && isCounterIncrementValid(changedKeys, 'casper-1')
          && isCounterIncrementValid(changedKeys, 'casper-2')
          && isCounterIncrementValid(changedKeys, 'casper-3')
          && isCounterIncrementValid(changedKeys, 'casper-4')
          && isCounterIncrementValid(changedKeys, 'casper-5')
          && isCounterIncrementValid(changedKeys, 'casper-6')
          && isCounterIncrementValid(changedKeys, 'comefeas-1')
          && isCounterIncrementValid(changedKeys, 'comefeas-2')
          && isCounterIncrementValid(changedKeys, 'comefeas-3')
          && isCounterIncrementValid(changedKeys, 'comefeas-4')
          && isCounterIncrementValid(changedKeys, 'soltero-1')
          && isCounterIncrementValid(changedKeys, 'soltero-2')
          && isCounterIncrementValid(changedKeys, 'soltero-3')
          && isCounterIncrementValid(changedKeys, 'soltero-4')
          && isCounterIncrementValid(changedKeys, 'anecdota-1')
          && isCounterIncrementValid(changedKeys, 'anecdota-2')
          && isCounterIncrementValid(changedKeys, 'anecdota-3')
          && isCounterIncrementValid(changedKeys, 'anecdota-4')
          && isCounterIncrementValid(changedKeys, 'anecdota-5')
          && isCounterIncrementValid(changedKeys, 'anecdota-6')
          && isCounterIncrementValid(changedKeys, 'meme-1')
          && isCounterIncrementValid(changedKeys, 'meme-2')
          && isCounterIncrementValid(changedKeys, 'meme-3')
          && isCounterIncrementValid(changedKeys, 'meme-4')
          && isCounterIncrementValid(changedKeys, 'meme-5')
          && isCounterIncrementValid(changedKeys, 'meme-6')
          && isCounterIncrementValid(changedKeys, 'meme-7')
          && isCounterIncrementValid(changedKeys, 'meme-8')
          && isCounterIncrementValid(changedKeys, 'mensaje-1')
          && isCounterIncrementValid(changedKeys, 'mensaje-2')
          && isCounterIncrementValid(changedKeys, 'mensaje-3')
          && isCounterIncrementValid(changedKeys, 'mensaje-4')
          && isCounterIncrementValid(changedKeys, 'foto-1')
          && isCounterIncrementValid(changedKeys, 'foto-2')
          && isCounterIncrementValid(changedKeys, 'foto-3')
          && isCounterIncrementValid(changedKeys, 'foto-4')
          && isCounterIncrementValid(changedKeys, 'video-1')
          && isCounterIncrementValid(changedKeys, 'video-2')
          && isCounterIncrementValid(changedKeys, 'video-3')
          && isCounterIncrementValid(changedKeys, 'video-4')
          && isCounterIncrementValid(changedKeys, 'correa-1')
          && isCounterIncrementValid(changedKeys, 'correa-2')
          && isCounterIncrementValid(changedKeys, 'correa-3')
          && isCounterIncrementValid(changedKeys, 'correa-4');
      }

      // Los totales son agregados, así que se lee solo el documento fijo.
      allow get: if voteId == 'actual';
      allow list: if false;
      allow create, delete: if false;
      allow update: if isVoteUpdateValid(voteId);
    }

    match /palabrasClave/{entryId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
