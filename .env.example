# Plantilla de configuración local. Copia este fichero a `.env.local` y rellénalo
# con las credenciales de tu proyecto de Firebase.
#
#   Firebase Console → Configuración del proyecto → Tus aplicaciones → App web
#
# Nada de esto es secreto: el prefijo VITE_ significa que Vite incrusta el valor
# en el bundle y cualquiera puede leerlo. Son identificadores de proyecto, no
# credenciales. La clave privada de la cuenta de servicio NUNCA va aquí.

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Opcional, y no hace falta para que la aplicación funcione. Si la dejas
# vacía, client.ts arranca sin App Check y sin lanzar ningún error; la
# protección de las palabras secretas la ponen firestore.rules, no esto.
# Rellénala solo si además quieres activar reCAPTCHA v3 como defensa extra.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Antes de nada: despliega las reglas, o el login fallará siempre.
#   firebase deploy --only firestore:rules --project mentipremios
